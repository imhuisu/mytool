<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <!-- ‹ › 누르는 칸을 크게: 제목 양옆 남는 폭을 전부 차지 (위젯은 좌우 밀기를 못 받음) -->
        <TextView android:id="@+id/prev" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:gravity="center_vertical|start" android:paddingStart="6dp"
            android:text="‹" android:textSize="28sp" android:textColor="@color/muted" />
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="40dp"
            android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:id="@+id/next" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:gravity="center_vertical|end" android:paddingEnd="6dp"
            android:text="›" android:textSize="28sp" android:textColor="@color/muted" />
        <TextView android:id="@+id/add" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="4dp"
            android:gravity="center" android:text="+" android:textSize="20sp" android:textColor="@android:color/white"
            android:background="@drawable/add_bg" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <TextView style="@style/Wd" android:text="일" android:textColor="@color/c2" />
        <TextView style="@style/Wd" android:text="월" />
        <TextView style="@style/Wd" android:text="화" />
        <TextView style="@style/Wd" android:text="수" />
        <TextView style="@style/Wd" android:text="목" />
        <TextView style="@style/Wd" android:text="금" />
        <TextView style="@style/Wd" android:text="토" android:textColor="@color/c0" />
    </LinearLayout>
    <LinearLayout android:id="@+id/weeks" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" />
</LinearLayout>